<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.nalg.yapsum-weekly</string>

    <key>LimitLoadToSessionType</key>
    <array>
        <string>Aqua</string>
        <string>Background</string>
    </array>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>/Users/clawd/repos/yap-sum/scripts/weekly-check.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/clawd/repos/yap-sum</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>YAPSUM_HEADLESS</key>
        <string>1</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/clawd/Library/Logs/yap-sum/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/clawd/Library/Logs/yap-sum/launchd.log</string>
</dict>
</plist>
